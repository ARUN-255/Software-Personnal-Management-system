# Copy this file to backend/.env. Paste values only into backend/.env.
# backend/.env is excluded from Git. Never use VITE_ for secret keys.
SPRING_PROFILES_ACTIVE=postgres
DB_URL=jdbc:postgresql://localhost:5432/personnel_management
DB_USERNAME=postgres
DB_PASSWORD=PASTE_YOUR_DATABASE_PASSWORD_HERE
FRONTEND_URL=http://localhost:5173
APP_TIME_ZONE=Asia/Kolkata
COOKIE_SECURE=false
APP_DEMO_DATA=false
# Only creates an owner when the database has no accounts. Existing accounts are unchanged.
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_PASSWORD=

# GOOGLE GEMINI: paste the key here, then enter a model ID available to your key.
GEMINI_API_KEY=
GEMINI_MODEL=

# EMAIL: required only for password-reset OTP and email copies of notifications.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_AUTH=true
MAIL_STARTTLS=true

# AWS: keep local until your private S3 bucket is ready; then set s3.
STORAGE_PROVIDER=local
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
# Local development only. On AWS prefer an attached IAM role and leave these blank.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
APP_UPLOAD_DIR=uploads
