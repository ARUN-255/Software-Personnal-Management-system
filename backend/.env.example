# Copy this file to backend/.env. Paste values only into backend/.env.
# backend/.env is excluded from Git. Never use VITE_ for secret keys.
SPRING_PROFILES_ACTIVE=postgres
DB_URL=jdbc:postgresql://localhost:5432/personnel_management
DB_USERNAME=postgres
DB_PASSWORD=PASTE_YOUR_DATABASE_PASSWORD_HERE
FRONTEND_URL=http://localhost:5173
APP_TIME_ZONE=Asia/Kolkata
COOKIE_SECURE=false
APP_DEMO_DATA=false
# Only creates an owner when the database has no accounts. Existing accounts are unchanged.
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_PASSWORD=

# GOOGLE GEMINI: paste the key here, then enter a model ID available to your key.
GEMINI_API_KEY=
GEMINI_MODEL=

# Photos are stored locally in this folder.
APP_UPLOAD_DIR=uploads
